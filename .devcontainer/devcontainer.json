{
    "name": "nuxt-devcontainer",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "../"
    },
    "remoteUser": "root",
    "forwardPorts": [
        3000
    ],
    "portsAttributes": {
        "3000": {
            "label": "Application",
            "onAutoForward": "openPreview"
        }
    },
    "mounts": [
        "type=volume,target=${containerWorkspaceFolder}/node_modules"
    ],
    "postStartCommand": "pnpm install && pnpm postinstall"
}
